{
  "schemaVersion": 1,
  "id": "tungsten-update",
  "version": "${version}",
  "name": "Tungsten Update",
  "description": "Adds tungsten to Minecraft: a rare, brittle ore found underground, raw tungsten, ingots and a tungsten pickaxe. Work in progress.",
  "authors": [
    "TheRedEnderman"
  ],
  "contact": {
    "homepage": "https://github.com/TheRedEnderman/tungsten-update",
    "sources": "https://github.com/TheRedEnderman/tungsten-update",
    "issues": "https://github.com/TheRedEnderman/tungsten-update/issues"
  },
  "license": "CC0-1.0",
  "icon": "assets/tungsten-update/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "tungsten.update.TungstenUpdate"
    ],
    "client": [
      "tungsten.update.client.TungstenUpdateClient"
    ]
  },
  "mixins": [
    "tungsten-update.mixins.json",
    {
      "config": "tungsten-update.client.mixins.json",
      "environment": "client"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}